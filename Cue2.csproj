<Project Sdk="Godot.NET.Sdk/4.7.1">  
<PropertyGroup>  
<TargetFramework>net8.0</TargetFramework>  
<EnableDynamicLoading>true</EnableDynamicLoading>  
<AllowUnsafeBlocks>true</AllowUnsafeBlocks>  
<!-- Rug.Osc is .NET Framework-only; NU1701 is expected and accepted for net8.0. -->
<NoWarn>$(NoWarn);NU1701</NoWarn>
</PropertyGroup>  
<ItemGroup>  
<PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />  

 <PackageReference Include="Rug.Osc" Version="1.2.5" />
<PackageReference Include="SDL3-CS" Version="3.4.14.1" />  
<PackageReference Include="SDL3-CS.Native" Version="3.4.2" />  
<PackageReference Update="GodotSharp" Version="4.7.1" />  
</ItemGroup>  
<ItemGroup>
  <Compile Remove="bin\**" />
</ItemGroup>  
<ItemGroup>
  <EmbeddedResource Remove="bin\**" />
</ItemGroup>
<ItemGroup>
  <!-- Automated tests build as their own projects under tests/ (see tests/README.md). -->
  <Compile Remove="tests\**" />
  <None Remove="tests\**" />
  <EmbeddedResource Remove="tests\**" />
  <InternalsVisibleTo Include="Cue2.Tests" />
</ItemGroup>
<!-- Engine tests (tests/engine) run inside Godot through GdUnit4Net. Debug builds only, so
     exports never contain test code or test packages. -->
<ItemGroup Condition="'$(Configuration)' == 'Debug'">
  <PackageReference Include="gdUnit4.api" Version="5.1.0-rc5" PrivateAssets="all" />
  <PackageReference Include="gdUnit4.test.adapter" Version="3.1.1" PrivateAssets="all" />
  <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" PrivateAssets="all" />
  <Compile Include="tests\engine\**\*.cs" />
</ItemGroup>
<ItemGroup Condition="'$(Configuration)' != 'Debug'">
  <!-- Written by the GdUnit4 test adapter during an engine test run. -->
  <Compile Remove="gdunit4_testadapter_v5\**" />
</ItemGroup>
</Project> 
