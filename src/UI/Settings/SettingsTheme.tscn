focus_mode = 0
tooltip_text = "Add a Godot Theme resource (.tres) created in the Godot editor."
text = "Add Theme"

[node name="ThemeEditorHint" type="Label" parent="VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
