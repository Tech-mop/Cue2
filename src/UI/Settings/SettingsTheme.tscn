[gd_scene format=3]

[ext_resource type="Script" path="res://src/UI/Settings/SettingsTheme.cs" id="1_theme"]
[ext_resource type="PackedScene" path="res://src/UI/Controls/ColourButton.tscn" id="2_colour"]

[node name="SettingsTheme" type="ScrollContainer"]
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
size_flags_horizontal = 3
size_flags_vertical = 3
script = ExtResource("1_theme")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Header" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Theme"
vertical_alignment = 1
uppercase = true

[node name="HSeparator" type="HSeparator" parent="VBoxContainer"]
layout_mode = 2

[node name="Description" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.65, 0.65, 1)
theme_override_font_sizes/font_size = 10
text = "Application theme and accent colours. Saved as Cue2 Preferences, not with the showfile."
autowrap_mode = 3

[node name="ThemeRow" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2

[node name="ThemeLabel" type="Label" parent="VBoxContainer/ThemeRow"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 10
text = "Theme"
vertical_alignment = 1
tooltip_text = "UI theme. Cue2 (Default), Dark, and Light are shipped. You can also add a Godot Theme .tres."

[node name="ThemeOptionButton" type="OptionButton" parent="VBoxContainer/ThemeRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
focus_mode = 0
tooltip_text = "UI theme. Cue2 (Default), Dark, and Light are shipped. You can also add a Godot Theme .tres."

[node name="ThemeResetButton" type="Button" parent="VBoxContainer/ThemeRow"]
unique_name_in_owner = true
visible = false
