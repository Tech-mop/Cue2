; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Cue2"
config/version="0.1.0"
run/main_scene="res://src/App/Cue2Base.tscn"
run/print_header=false
config/use_custom_user_dir=true
config/custom_user_dir_name="Techmop/Cue2"
config/features=PackedStringArray("4.7", "C#")
boot_splash/stretch_mode=0
boot_splash/image="uid://da3ic4ewddkb"
config/icon="res://icon.svg"

[autoload]

GlobalData="*res://src/Services/GlobalData.cs"
GlobalSignals="*res://src/Services/GlobalSignals.cs"
GlobalStyles="*res://src/Services/GlobalStyles.cs"
EventLogger="*res://src/Services/EventLogger.cs"
DisplaysManager="*res://src/Services/DisplaysManager.cs"
SaveManager="*res://src/Services/SaveManager.cs"
InputActionsListener="*res://src/Services/InputActionsListener.cs"
UiUtilities="*res://src/UI/Utilities/UiUtilities.cs"
MediaEngine="*res://src/Services/MediaEngine.cs"
MediaBackupManager="*res://src/Services/MediaBackupManager.cs"
MediaHealthService="*res://src/Services/MediaHealthService.cs"
AudioDevices="*res://src/Services/AudioDevices.cs"
OscListen="*res://src/Domain/Connections/OscListen.cs"
OscConnections="*res://src/Domain/Connections/OscConnections.cs"
MidiManager="*res://src/Services/MidiManager.cs"

[debug]

file_logging/log_path="user://logs/Cue2Sytem.log"
file_logging/max_log_files=7

[display]

window/size/initial_position_type=4
window/size/borderless=true
window/subwindows/embed_subwindows=false
window/per_pixel_transparency/allowed=true
window/handheld/orientation=1

[dotnet]

project/assembly_name="Cue2"

[editor]

naming/default_signal_callback_name="_on{NodeName}{SignalName}"
naming/default_signal_callback_to_self_name="_on{Signal_name}"
naming/scene_name_casing=1
import/reimport_missing_imported_files=false

[gui]

theme/default_font_multichannel_signed_distance_field=true

